# Copiar como backend/.env y ajustar. Nunca subir el archivo .env al repositorio.

# Conexión a PostgreSQL con el rol de la aplicación (no con el superusuario)
DATABASE_URL=postgres://agroturno_app:CAMBIAR_CONTRASENA@localhost:5432/agroturno

# Conexión con privilegios de propietario: solo para migraciones y datos de prueba
DATABASE_URL_ADMIN=postgres://postgres:CAMBIAR_CONTRASENA@localhost:5432/agroturno

# true cuando la base exige TLS (Supabase u otro proveedor administrado)
DB_SSL=false
DB_MAX_CONEXIONES=5

# Duración de la sesión en horas
SESION_HORAS=8

# Contraseña para las cuentas ficticias que crea `npm run db:semilla`
SEMILLA_CONTRASENA=CAMBIAR_contrasena_de_prueba_2026

PORT=3000
NODE_ENV=development
